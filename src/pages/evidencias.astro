          <pre><code>{String.raw`CREATE OR REPLACE PROCEDURE sp_liquidar_empleado(
    p_id_empleado NUMBER, p_id_quincena VARCHAR2
) IS
    e_no_activo EXCEPTION;
    e_ya_existe EXCEPTION;
BEGIN
    -- Validación 1: empleado existe
    -- Validación 2: estado = 'ACTIVO' → RAISE_APPLICATION_ERROR(-20002, ...)
    -- Validación 3: no existe ya la liquidación → RAISE_APPLICATION_ERROR(-20003, ...)

    -- Calcular componentes (llama a fn_salario_base_q, fn_recargos, fn_bonificacion)
    -- Deducciones en orden: salud → pensión → fondo solidaridad → embargo → libranzas → aporte_vol

    -- Ajuste neto negativo (Regla 8):
    IF v_neto < 0 THEN
        v_total_ded := v_total_ded - v_embargo; v_embargo := 0;
        v_neto := v_bruto - v_total_ded;
        IF v_neto < 0 THEN
            v_total_ded := v_total_ded - v_libranzas; v_libranzas := 0;
            v_neto := v_bruto - v_total_ded;
        END IF;
    END IF;

    INSERT INTO LIQUIDACION (...) VALUES (...);
    COMMIT;
EXCEPTION
    WHEN OTHERS THEN ROLLBACK; RAISE;
END sp_liquidar_empleado;
/`}</code></pre>
