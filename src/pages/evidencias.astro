    <!-- 1.5 -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">1.5–1.8</span>
          <span class="ev-title">Consultas de espacios (disponibilidad, bloques, capacidad)</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Consultas para analizar espacios disponibles: por estado, bloque, capacidad y agrupaciones.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`-- Espacios disponibles
SELECT id_espacio, codigo, nombre, capacidad, estado
FROM espacio WHERE estado = 'Disponible' ORDER BY codigo;

-- Espacios por bloque
SELECT b.nombre_bloque, e.codigo, e.nombre, e.capacidad, e.estado
FROM espacio e
JOIN bloque b ON b.id_bloque = e.id_bloque
ORDER BY b.nombre_bloque, e.codigo;

-- Cantidad de espacios por estado
SELECT estado, COUNT(*) AS total FROM espacio GROUP BY estado;

-- Salones disponibles por capacidad
SELECT capacidad, COUNT(*) AS total_salones
FROM espacio WHERE estado = 'Disponible'
GROUP BY capacidad ORDER BY capacidad;`}</code></pre>
        </div>
      </div>
    </div>

    <!-- Grupos y clases -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">2.1–2.4</span>
          <span class="ev-title">Clases, grupos y docentes asignados</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Consultas sobre clases registradas, grupos activos, grupos con más estudiantes y docentes asignados por grupo.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`-- Ver clases registradas
SELECT id_clase, nombre, codigo_clase, tipo_clase,
       requiere_computadores, estado
FROM clase ORDER BY nombre;

-- Ver grupos con más estudiantes
SELECT g.id_grupo_clase, c.nombre AS clase,
       g.codigo_grupo, g.cantidad_estudiantes
FROM grupo_clase g
JOIN clase c ON c.id_clase = g.id_clase
WHERE g.estado = 'Activo'
ORDER BY g.cantidad_estudiantes DESC;

-- Docentes asignados a grupos
SELECT u.nombre AS docente, u.correo,
       c.nombre AS clase, g.codigo_grupo,
       g.cantidad_estudiantes, dgc.estado
FROM docente_grupo_clase dgc
JOIN usuario u ON u.id_usuario = dgc.id_usuario
JOIN grupo_clase g ON g.id_grupo_clase = dgc.id_grupo_clase
JOIN clase c ON c.id_clase = g.id_clase
ORDER BY u.nombre, c.nombre;`}</code></pre>
        </div>
      </div>
    </div>

    <!-- Reservas -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">3.1–3.6</span>
          <span class="ev-title">Gestión de reservas (manuales, semestrales, conflictos)</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Consultas de reservas recientes, automáticas, conteos por origen, distribución por salón y detección de conflictos de horario.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`-- Reservas recientes (últimas 20)
          SELECT r.id_reserva, u.nombre AS usuario, e.codigo AS salon,
                r.fecha_reserva, r.hora_inicio, r.hora_fin,
                r.estado_reserva, r.origen
          FROM reserva r
          JOIN usuario u ON u.id_usuario = r.id_usuario
          JOIN espacio e ON e.id_espacio = r.id_espacio
          ORDER BY r.id_reserva DESC LIMIT 20;

          -- Contar por origen
          SELECT COUNT(*) AS reservas_semestrales
          FROM reserva WHERE origen = 'SEMESTRAL';

          SELECT COUNT(*) AS reservas_manuales
          FROM reserva WHERE origen = 'MANUAL';

          -- Reservas por salón
          SELECT e.codigo, e.capacidad, COUNT(*) AS total_reservas
          FROM reserva r
          JOIN espacio e ON e.id_espacio = r.id_espacio
          WHERE r.origen = 'SEMESTRAL'
          GROUP BY e.codigo, e.capacidad
          ORDER BY total_reservas DESC;`}</code></pre>
        </div>
      </div>
    </div>

    <!-- Tailor Made -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">4.1–4.7</span>
          <span class="ev-title">Algoritmo Tailor Made — asignación automática de salones</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Consultas del módulo de asignación semestral automática: horarios activos, distribución por salón, docentes asignados, y limpieza de asignación.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`-- Horarios semestrales activos (vista completa)
SELECT hs.id_horario, c.nombre AS clase,
       g.codigo_grupo, g.cantidad_estudiantes,
       e.codigo AS salon, e.capacidad,
       hs.dia_semana, hs.hora_inicio, hs.hora_fin,
       hs.diferencia_capacidad, hs.criterio_asignacion, hs.estado
FROM horario_semestre hs
JOIN grupo_clase g ON g.id_grupo_clase = hs.id_grupo_clase
JOIN clase c ON c.id_clase = g.id_clase
JOIN espacio e ON e.id_espacio = hs.id_espacio
WHERE hs.estado = 'Activo'
ORDER BY
    FIELD(hs.dia_semana,'Lunes','Martes','Miércoles','Jueves','Viernes'),
    hs.hora_inicio;

-- Comparar salones usados vs. disponibles
SELECT
    (SELECT COUNT(DISTINCT id_espacio) FROM horario_semestre
     WHERE estado = 'Activo') AS salones_usados,
    (SELECT COUNT(*) FROM espacio
     WHERE estado = 'Disponible') AS salones_disponibles;

-- Limpiar asignación automática
DELETE FROM reserva WHERE origen = 'SEMESTRAL';
DELETE FROM horario_semestre WHERE estado = 'Activo';`}</code></pre>
        </div>
      </div>
    </div>

    <!-- Trigger -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">6.2</span>
          <span class="ev-title">Trigger — historial de cambios de estado de espacios</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Trigger AFTER UPDATE que registra automáticamente cada cambio de estado de un espacio en la tabla de historial, garantizando trazabilidad.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`USE bdatos2_sgec;
DROP TRIGGER IF EXISTS trg_historial_cambio_estado_espacio;
DELIMITER $$

CREATE TRIGGER trg_historial_cambio_estado_espacio
AFTER UPDATE ON espacio
FOR EACH ROW
BEGIN
    IF OLD.estado <> NEW.estado THEN
        INSERT INTO historial (
            id_espacio, estado_anterior, estado_nuevo,
            fecha_cambio, hora_cambio, responsable_cambio, observacion
        ) VALUES (
            NEW.id_espacio, OLD.estado, NEW.estado,
            CURDATE(), CURTIME(), NULL,
            CONCAT('Cambio automático de estado del espacio ', NEW.codigo)
        );
    END IF;
END$$
DELIMITER ;

-- Prueba del trigger
UPDATE espacio SET estado = 'Mantenimiento' WHERE id_espacio = 1;
SELECT * FROM historial ORDER BY id_historial DESC LIMIT 5;
UPDATE espacio SET estado = 'Disponible' WHERE id_espacio = 1;`}</code></pre>
        </div>
      </div>
    </div>

    <!-- Procedimiento almacenado -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">7.1</span>
          <span class="ev-title">Procedimiento almacenado — crear_reserva_segura</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Procedimiento que valida disponibilidad del espacio y ausencia de conflictos de horario antes de insertar una reserva. Usa SIGNAL para errores de negocio.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`USE bdatos2_sgec;
DROP PROCEDURE IF EXISTS crear_reserva_segura;
DELIMITER $$

CREATE PROCEDURE crear_reserva_segura(
    IN p_id_usuario INT,
    IN p_id_espacio INT,
    IN p_fecha_reserva DATE,
    IN p_hora_inicio TIME,
    IN p_hora_fin TIME
)
BEGIN
    DECLARE v_total_conflictos INT DEFAULT 0;
    DECLARE v_estado_espacio VARCHAR(50);

    SELECT estado INTO v_estado_espacio
    FROM espacio WHERE id_espacio = p_id_espacio LIMIT 1;

    IF v_estado_espacio <> 'Disponible' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'El espacio no está disponible para reservar.';
    END IF;

    SELECT COUNT(*) INTO v_total_conflictos
    FROM reserva
    WHERE id_espacio = p_id_espacio
      AND fecha_reserva = p_fecha_reserva
      AND estado_reserva = 'Activa'
      AND (
            (p_hora_inicio >= hora_inicio AND p_hora_inicio < hora_fin)
         OR (p_hora_fin > hora_inicio AND p_hora_fin <= hora_fin)
         OR (p_hora_inicio <= hora_inicio AND p_hora_fin >= hora_fin)
      );

    IF v_total_conflictos = 0 THEN
        INSERT INTO reserva (
            id_usuario, id_espacio, fecha_reserva,
            hora_inicio, hora_fin, estado_reserva, origen
        ) VALUES (
            p_id_usuario, p_id_espacio, p_fecha_reserva,
            p_hora_inicio, p_hora_fin, 'Activa', 'MANUAL'
        );
    ELSE
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Ya existe una reserva activa para ese espacio en ese horario.';
    END IF;
END$$
DELIMITER ;

-- Llamar procedimiento
CALL crear_reserva_segura(1, 5, '2026-05-25', '09:00:00', '11:00:00');`}</code></pre>
        </div>
      </div>
    </div>

    <!-- MongoDB SGEC -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">10–16</span>
          <span class="ev-title">MongoDB SGEC — Auditorías, seguridad y estadísticas</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Colecciones MongoDB del SGEC: audit_logs, eventos_seguridad, eventos_asignacion y estadísticas. Consultas de login, asignaciones semestrales y dashboard rápido.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`// Conectar a la base
mongosh "mongodb://192.168.56.101:27018/sgec_logs?directConnection=true"
use sgec_logs

// Dashboard rápido — resumen general
printjson({
  audit_logs:               db.audit_logs.countDocuments(),
  eventos_asignacion:       db.eventos_asignacion.countDocuments(),
  eventos_seguridad:        db.eventos_seguridad.countDocuments(),
  estadisticas:             db.estadisticas.countDocuments(),
  asignaciones_semestrales: db.audit_logs.countDocuments({ accion: "ASIGNACION_SEMESTRAL" }),
  login_fallidos:           db.eventos_seguridad.countDocuments({ tipo: "LOGIN_FAIL" })
})

// Últimas auditorías
db.audit_logs.find().sort({ fecha: -1 }).limit(10).pretty()

// Login exitoso / fallido
db.audit_logs.find({ accion: "LOGIN_OK" }).sort({ fecha: -1 }).limit(10)
db.audit_logs.find({ accion: "LOGIN_FAIL" }).sort({ fecha: -1 }).limit(10)

// Agrupar eventos de seguridad por tipo
db.eventos_seguridad.aggregate([
  { $group: { _id: "$tipo", total: { $sum: 1 } } },
  { $sort: { total: -1 } }
])

// Asignaciones por salón
db.audit_logs.aggregate([
  { $match: { accion: "ASIGNACION_SEMESTRAL" } },
  { $group: { _id: "$extra.salon", total: { $sum: 1 } } },
  { $sort: { total: -1 } }
])`}</code></pre>
        </div>
      </div>
    </div>

    <!-- Patrones NoSQL -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">18</span>
          <span class="ev-title">Patrones de diseño NoSQL aplicados en SGEC</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Cuatro patrones de diseño MongoDB identificados e implementados en el proyecto SGEC.</div>
        <div class="pattern-grid">
          <div class="pattern-card">
            <h4>Polymorphic Pattern</h4>
            <p>Colección <code>audit_logs</code> almacena eventos de distintos tipos (LOGIN_OK, LOGIN_FAIL, ASIGNACION_SEMESTRAL) con campos base comunes y datos extras variables.</p>
          </div>
          <div class="pattern-card">
            <h4>Computed Pattern</h4>
            <p>Colección <code>estadisticas</code> guarda resultados ya calculados (totales de reservas, asignaciones, conflictos) para reportes rápidos sin recalcular.</p>
          </div>
          <div class="pattern-card">
            <h4>Subset Pattern</h4>
            <p>Colección <code>eventos_seguridad</code> proyecta solo los campos relevantes (fecha, tipo, correo, IP) sin exponer el documento completo.</p>
          </div>
          <div class="pattern-card">
            <h4>Extended Reference</h4>
            <p>Colecciones <code>eventos_asignacion</code> y <code>audit_logs</code> guardan tanto el ID de MySQL como datos descriptivos (clase, salón, capacidad) para no consultar de nuevo.</p>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /tab-sgec -->

  <!-- ======================================================== -->
  <!-- PANEL 2: SQL AVANZADO -->
  <!-- ======================================================== -->
  <div id="tab-sql" class="panel">
    <div class="section-intro">
      <h2>Taller SQL Avanzado — Ajuste Salarial (Oracle)</h2>
      <p>Taller aplicado con CTE, funciones analíticas (DENSE_RANK), MERGE, transacciones ACID con SAVEPOINT, auditoría y validación de topes. Variante 2 del taller (departamento 60 excluido, 18 meses historial).</p>
    </div>

    <!-- Diagnóstica -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">1</span>
          <span class="ev-title">Consulta diagnóstica — CTEs + DENSE_RANK + antigüedad</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Cruza empleados, departamentos, estadísticas departamentales e historial laboral en una sola pasada. Calcula brecha porcentual al promedio y ranking salarial con DENSE_RANK().</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`WITH
params AS (
    SELECT excluded_department_id, min_years_service,
           recent_job_history_months, gap_high_threshold_pct,
           gap_mid_threshold_pct, raise_high_pct, raise_mid_pct,
           raise_low_pct, max_salary_vs_avg_pct
    FROM t1_variants WHERE variant_id = &p_variant_id
),
dept_stats AS (
    SELECT department_id,
           AVG(salary)  AS dept_avg_salary,
           MAX(salary)  AS dept_max_salary,
           COUNT(*)     AS dept_employee_count
    FROM t1_employees
    WHERE department_id IS NOT NULL
    GROUP BY department_id
),
recent_hist AS (
    SELECT DISTINCT jh.employee_id
    FROM t1_job_history jh
    CROSS JOIN params p
    WHERE jh.start_date >= ADD_MONTHS(TRUNC(SYSDATE), -p.recent_job_history_months)
       OR jh.end_date   >= ADD_MONTHS(TRUNC(SYSDATE), -p.recent_job_history_months)
)
SELECT
    e.employee_id, e.first_name, e.last_name,
    e.department_id, d.department_name, e.salary,
    TRUNC(MONTHS_BETWEEN(TRUNC(SYSDATE), e.hire_date)/12) AS years_service,
    ROUND(ds.dept_avg_salary, 2) AS dept_avg_salary,
    ROUND((ds.dept_avg_salary - e.salary) / NULLIF(ds.dept_avg_salary,0)*100, 4)
        AS pct_gap_to_avg,
    CASE WHEN rh.employee_id IS NOT NULL THEN 'SI' ELSE 'NO' END
        AS recent_job_history_flag,
    DENSE_RANK() OVER (
        PARTITION BY e.department_id ORDER BY e.salary DESC
    ) AS salary_rank_in_department
FROM t1_employees e
LEFT JOIN t1_departments d  ON d.department_id  = e.department_id
LEFT JOIN dept_stats      ds ON ds.department_id = e.department_id
LEFT JOIN recent_hist     rh ON rh.employee_id   = e.employee_id
ORDER BY e.department_id NULLS LAST, e.salary DESC;`}</code></pre>
        </div>
      </div>
    </div>

    <!-- Elegibles -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">2</span>
          <span class="ev-title">Decisión de elegibilidad — reglas de exclusión y ajuste</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">Aplica todas las reglas de exclusión de la variante 2 en orden de severidad y asigna AJUSTE_ALTO (8%), AJUSTE_MEDIO (5%) o AJUSTE_BAJO (3%) a los elegibles.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`-- Criterios de exclusión aplicados en orden:
-- SIN_DEPARTAMENTO → DEPTO_EXCLUIDO (60) → DEPTO_MENOR_A_3
-- → ANTIGUEDAD_INSUFICIENTE (<3 años) → HISTORIAL_RECIENTE (18 m)
-- → MANAGER_O_DIRECTIVO → SALARIO_NO_APLICA (≥ 120% avg)

CASE
    WHEN department_id IS NULL               THEN 'NO_ELEGIBLE' -- SIN_DEPARTAMENTO
    WHEN department_id = excluded_dept_id    THEN 'NO_ELEGIBLE' -- DEPTO_EXCLUIDO
    WHEN dept_employee_count < 3             THEN 'NO_ELEGIBLE' -- DEPTO_MENOR_A_3
    WHEN years_service < min_years_service   THEN 'NO_ELEGIBLE' -- ANTIGUEDAD_INSUFICIENTE
    WHEN recent_job_history_flag = 'SI'      THEN 'NO_ELEGIBLE' -- HISTORIAL_RECIENTE
    WHEN manager_or_exec_flag = 'SI'         THEN 'NO_ELEGIBLE' -- MANAGER_O_DIRECTIVO
    WHEN salary >= dept_avg * max_pct / 100  THEN 'NO_ELEGIBLE' -- SALARIO_NO_APLICA
    ELSE 'ELEGIBLE'
END AS eligibility_flag,

-- Porcentaje de ajuste para elegibles
CASE
    WHEN pct_gap_to_avg > gap_high_threshold_pct THEN raise_high_pct -- AJUSTE_ALTO  8%
    WHEN pct_gap_to_avg > gap_mid_threshold_pct  THEN raise_mid_pct  -- AJUSTE_MEDIO 5%
    ELSE raise_low_pct                                                -- AJUSTE_BAJO  3%
END AS adjustment_pct`}</code></pre>
        </div>
      </div>
    </div>

    <!-- MERGE transaccional -->
    <div class="ev-card">
      <div class="ev-header" onclick="toggle(this)">
        <div class="ev-header-left">
          <span class="ev-num">4</span>
          <span class="ev-title">Ejecución transaccional — MERGE + INSERT auditoría + SAVEPOINT</span>
        </div>
        <span class="ev-toggle">▼</span>
      </div>
      <div class="ev-body">
        <div class="ev-desc">MERGE actualiza salarios de elegibles respetando el tope (LEAST). INSERT registra la auditoría. SAVEPOINT permite revertir si la validación intermedia detecta incumplimientos.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`SAVEPOINT sv_before_adjustment;

-- Actualizar salarios con tope
MERGE INTO t1_employees tgt
USING (
    -- CTE con elegibles calculados
    SELECT e.employee_id, e.salary AS salary_before,
           ds.dept_avg_salary,
           CASE WHEN pct_gap > gap_high THEN raise_high
                WHEN pct_gap > gap_mid  THEN raise_mid
                ELSE raise_low END AS adjustment_pct,
           p.max_salary_vs_avg_pct
    FROM ... -- elegibles
) src
ON (tgt.employee_id = src.employee_id)
WHEN MATCHED THEN UPDATE SET
    tgt.salary = LEAST(
        ROUND(src.salary_before * (1 + src.adjustment_pct / 100), 2),
        ROUND(src.dept_avg_salary * src.max_salary_vs_avg_pct / 100, 2)
    );

-- Validación intermedia (debe mostrar solo CUMPLE)
SELECT employee_id, salary_after, allowed_max_salary,
       CASE WHEN salary_after <= allowed_max_salary
            THEN 'CUMPLE' ELSE 'INCUMPLE - SUPERA TOPE'
       END AS validation_status
FROM audit_salary_adjustments_t1
WHERE execution_tag = '&p_execution_tag';

COMMIT; -- Si todo cumple. Si no: ROLLBACK TO SAVEPOINT sv_before_adjustment;`}</code></pre>
        </div>
      </div>
