          <pre><code>{String.raw`SELECT
    u.id_usuario,
    u.nombre,
    u.correo,
    r.nombre_rol
FROM usuario u
JOIN rol r ON r.id_rol = u.id_rol
ORDER BY u.id_usuario;`}</code></pre>
        </div>
