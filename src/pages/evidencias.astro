CREATE OR REPLACE FUNCTION fn_salario_base_q(
    p_id_empleado NUMBER, p_id_quincena VARCHAR2
) RETURN NUMBER IS ...
-- PLANTA → salario/2 | TEMPORAL → salario×horas_normales | SERVICIOS → (salario - retención)/2

-- fn_recargos: cursor explícito por tipo de hora
CREATE OR REPLACE FUNCTION fn_recargos(
    p_id_empleado NUMBER, p_id_quincena VARCHAR2
) RETURN NUMBER IS
    CURSOR cur_horas(p_emp NUMBER, p_quin VARCHAR2) IS
        SELECT tipo_hora, cantidad_horas
        FROM HORAS_TRABAJADAS WHERE ...;
-- Acumula: NOCTURNA × rec_noct, DOMINICAL × rec_dom, NOCTURNA_DOM × rec_ndom

-- fn_bonificacion: antigüedad + sanciones
-- 3–5 años → 3% | 6–10 → 6% | >10 → 10%
-- Se anula si tiene >2 sanciones en los últimos 6 meses

-- fn_bruto: suma base + recargos + bono + auxilio_transporte + bono_sede
-- Auxilio solo si salario_mensual ≤ 2×SMLMV`}</code></pre>
