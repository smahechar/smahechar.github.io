      <div class="ev-body">
        <div class="ev-desc">Package completo con caché de parámetros, liquidación individual y masiva (BULK COLLECT + FORALL + SAVE EXCEPTIONS), función pipelined con SQL dinámico y auditoría con AUTONOMOUS_TRANSACTION.</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`-- Puntos clave del package body:

-- Punto 6: BULK COLLECT + FORALL
SELECT id_empleado BULK COLLECT INTO v_ids
FROM EMPLEADOS WHERE estado = 'ACTIVO'
  AND id_empleado NOT IN (
      SELECT id_empleado FROM LIQUIDACION WHERE id_quincena = p_id_quincena
  );

-- Calcular cada liquidación en bucle FOR + llenar arrays
-- Luego insertar masivamente:
FORALL i IN 1..v_ids.COUNT SAVE EXCEPTIONS
    INSERT INTO LIQUIDACION (...) VALUES (v_arr_id(i), v_ids(i), ...);

-- Punto 7: Función pipelined con SQL dinámico
FUNCTION fn_reporte_nomina(p_cod_sede VARCHAR2, p_tipo_contrato VARCHAR2)
RETURN t_lista_liq PIPELINED IS
    TYPE t_cur IS REF CURSOR;
    v_cur t_cur;
    v_sql VARCHAR2(2000);
BEGIN
    v_sql := 'SELECT ... FROM LIQUIDACION l JOIN EMPLEADOS e ... WHERE 1=1 ';
    IF p_cod_sede IS NOT NULL THEN v_sql := v_sql || 'AND e.cod_sede = :sede '; END IF;
    OPEN v_cur FOR v_sql USING p_cod_sede;
    LOOP FETCH v_cur INTO v_fila; EXIT WHEN v_cur%NOTFOUND; PIPE ROW(v_fila); END LOOP;
END;

-- Punto 8: AUTONOMOUS_TRANSACTION para log de auditoría
PROCEDURE sp_log_nomina(...) IS
    PRAGMA AUTONOMOUS_TRANSACTION;
BEGIN
    INSERT INTO LOG_NOMINA (...) VALUES (...);
    COMMIT; -- No afecta la transacción principal
END;

-- Uso del package
BEGIN
    PKG_NOMINA.sp_liquidar_quincena('2026-Q1-ENE');
END;
/`}</code></pre>
