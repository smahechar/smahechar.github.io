DESCRIBE espacio;
DESCRIBE reserva;
DESCRIBE horario_semestre;
DESCRIBE historial;
DESCRIBE mantenimiento;
DESCRIBE ticket_docente;
DESCRIBE grupo_clase;
DESCRIBE clase;`}</code></pre>
