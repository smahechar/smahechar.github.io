      <div class="ev-body">
        <div class="ev-desc">Trigger compuesto con tres secciones: BEFORE EACH ROW (validaciones + ajuste neto negativo), AFTER EACH ROW (log alertas + actualizar saldo libranzas), AFTER STATEMENT (log del lote).</div>
        <div class="code-wrap">
          <button class="copy-btn" onclick="copyCode(this)">Copiar</button>
          <pre><code>{String.raw`CREATE OR REPLACE TRIGGER trg_liquidacion_compound
FOR INSERT ON LIQUIDACION
COMPOUND TRIGGER

    -- Estado compartido entre secciones
    TYPE t_alertas_tab IS TABLE OF t_alerta INDEX BY PLS_INTEGER;
    v_alertas t_alertas_tab;

BEFORE EACH ROW IS BEGIN
    -- Valida salario_base_q >= 0
    IF :NEW.salario_base_q < 0 THEN
        RAISE_APPLICATION_ERROR(-20010, 'Salario base no puede ser negativo');
    END IF;
    -- Ajusta neto negativo (elimina embargo, luego libranzas)
    IF :NEW.neto < 0 THEN
        :NEW.total_deducciones := :NEW.total_deducciones - :NEW.embargo;
        :NEW.embargo := 0;
        -- ... registra alerta para AFTER EACH ROW
    END IF;
END BEFORE EACH ROW;

AFTER EACH ROW IS BEGIN
    -- Registra alerta en LOG_NOMINA
    -- Actualiza saldo_pendiente de LIBRANZAS activas
END AFTER EACH ROW;

AFTER STATEMENT IS BEGIN
    -- Log del lote completo
    INSERT INTO LOG_NOMINA (...) VALUES (...);
    v_alertas.DELETE; -- Limpiar para el siguiente lote
END AFTER STATEMENT;

END trg_liquidacion_compound;
/`}</code></pre>
