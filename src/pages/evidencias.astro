    vd_fecha TIMESTAMP := SYSTIMESTAMP;
    vn_primo NUMBER;
BEGIN
    SELECT COUNT(*) INTO vn_primo FROM dual
    WHERE (
        SELECT COUNT(*) FROM (
            SELECT LEVEL i FROM dual
            CONNECT BY LEVEL <= TO_CHAR(SYSDATE, 'DD')
        )
        WHERE MOD(TO_CHAR(SYSDATE, 'DD'), i) = 0
    ) = 2;

    IF vn_primo = 1 THEN
        dbms_output.put_line('Es primo');
    ELSE
        dbms_output.put_line('No es primo');
    END IF;
END;
/`}</code></pre>
